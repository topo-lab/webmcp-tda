{
  "name": "webmcp-tda",
  "version": "0.1.0",
  "private": true,
  "description": "A shared browser-local persistent homology workbench for people and WebMCP agents",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run"
  },
  "dependencies": {
    "playcanvas": "^2.21.4",
    "plotly.js-basic-dist-min": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tda-viz-react": "file:vendor/tda-viz-react-0.1.0.tgz",
    "tda-wasm": "file:vendor/tda-wasm"
  },
  "devDependencies": {
    "@types/plotly.js": "^3.0.13",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^3.2.7",
    "ajv": "^8.17.1",
    "cypress": "^15.17.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
